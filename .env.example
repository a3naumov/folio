# Docker Configuration
COMPOSE_PROJECT_NAME=folio
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# All core services start together; reserved for future optional groups.
COMPOSE_PROFILES=

# Development Ports
SERVICE_CADDY_PORT=8080
SERVICE_FRONTEND_PORT=5173
SERVICE_POSTGRES_PORT=5432

# Development IDE Configuration
PHP_IDE_CONFIG_SERVER_NAME=folio

# Production HTTPS Configuration
APP_DOMAIN=app.example.com
SERVICE_CADDY_HTTPS_PORT=443

# Laravel Configuration (generated by make init)
APP_KEY=

# PostgreSQL Configuration (password generated by make init)
POSTGRES_DB=folio
POSTGRES_USER=folio
POSTGRES_PASSWORD=
